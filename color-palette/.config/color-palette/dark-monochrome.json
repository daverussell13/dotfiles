{
  "meta": {
    "name": "Dark Monochrome",
    "version": "1.0.0",
    "description": "A grayscale-only color system based on the Dark Monochrome palette. Uses brightness and contrast instead of hue for visual hierarchy and semantic states."
  },

  "palette": {
    "primary": {
      "50":  "#F5F5F5",
      "100": "#E0E0E0",
      "200": "#D0D0D0",
      "300": "#C4C4C4",
      "400": "#C0C0C0",
      "500": "#A6A6A6",
      "600": "#848484",
      "700": "#707070",
      "800": "#5C5C5C",
      "900": "#4A4A4A"
    },

    "secondary": {
      "50":  "#FFFFFF",
      "100": "#E0E0E0",
      "200": "#D0D0D0",
      "300": "#C0C0C0",
      "400": "#B8B8B8",
      "500": "#B0B0B0",
      "600": "#A6A6A6",
      "700": "#8A8A8A",
      "800": "#7A7A7A",
      "900": "#686868"
    },

    "neutral": {
      "50":  "#FFFFFF",
      "100": "#E0E0E0",
      "200": "#C4C4C4",
      "300": "#A6A6A6",
      "400": "#848484",
      "500": "#666666",
      "600": "#4A4A4A",
      "700": "#3D3D3D",
      "800": "#222222",
      "900": "#080808"
    },

    "success": {
      "50":  "#E0E0E0",
      "100": "#D0D0D0",
      "500": "#C0C0C0",
      "600": "#A6A6A6",
      "700": "#848484"
    },

    "warning": {
      "50":  "#E0E0E0",
      "100": "#D0D0D0",
      "500": "#B8B8B8",
      "600": "#A6A6A6",
      "700": "#848484"
    },

    "danger": {
      "50":  "#E0E0E0",
      "100": "#D0D0D0",
      "500": "#E0E0E0",
      "600": "#D0D0D0",
      "700": "#C0C0C0"
    },

    "info": {
      "50":  "#E0E0E0",
      "100": "#D0D0D0",
      "500": "#B8B8B8",
      "600": "#A6A6A6",
      "700": "#848484"
    }
  },

  "semantic": {
    "light": {
      "background": "{neutral.50}",
      "surface": "#ffffff",
      "border": "{neutral.200}",
      "text-primary": "{neutral.900}",
      "text-secondary": "{neutral.600}",
      "text-disabled": "{neutral.400}",
      "action-primary": "{primary.600}",
      "action-primary-hover": "{primary.700}",
      "action-secondary": "{secondary.600}",
      "success": "{success.600}",
      "success-bg": "{success.50}",
      "warning": "{warning.600}",
      "warning-bg": "{warning.50}",
      "danger": "{danger.600}",
      "danger-bg": "{danger.50}",
      "info": "{info.600}",
      "info-bg": "{info.50}"
    },

    "dark": {
      "background": "#080808",
      "surface": "#121212",
      "surface-hover": "#1A1A1A",
      "surface-active": "#222222",
      "border": "#1A1A1A",
      "border-strong": "#303030",

      "text-primary": "#C0C0C0",
      "text-secondary": "#A6A6A6",
      "text-muted": "#848484",
      "text-disabled": "#666666",
      "text-emphasis": "#D0D0D0",
      "text-bright": "#E0E0E0",

      "action-primary": "#C0C0C0",
      "action-primary-hover": "#D0D0D0",
      "action-secondary": "#A6A6A6",

      "success": "#C0C0C0",
      "success-bg": "#1A1A1A",

      "warning": "#D0D0D0",
      "warning-bg": "#222222",

      "danger": "#E0E0E0",
      "danger-bg": "#1A1A1A",

      "info": "#B8B8B8",
      "info-bg": "#121212"
    }
  },

  "terminal": {
    "black": "#000000",
    "red": "#4A4A4A",
    "green": "#5C5C5C",
    "yellow": "#666666",
    "blue": "#707070",
    "magenta": "#7A7A7A",
    "cyan": "#848484",
    "white": "#A6A6A6",

    "bright_black": "#3D3D3D",
    "bright_red": "#686868",
    "bright_green": "#A6A6A6",
    "bright_yellow": "#B0B0B0",
    "bright_blue": "#B8B8B8",
    "bright_magenta": "#D0D0D0",
    "bright_cyan": "#C0C0C0",
    "bright_white": "#E0E0E0"
  },

  "ui": {
    "background": "#080808",
    "surface": "#121212",
    "surface-hover": "#1A1A1A",
    "surface-active": "#222222",

    "border": "#1A1A1A",
    "border-strong": "#303030",

    "text-primary": "#C0C0C0",
    "text-secondary": "#A6A6A6",
    "text-muted": "#848484",
    "text-disabled": "#666666",
    "text-emphasis": "#D0D0D0",
    "text-bright": "#E0E0E0",

    "selection-background": "#1A1A1A",
    "selection-foreground": "#C4C4C4",

    "cursor-background": "#C4C4C4",
    "cursor-foreground": "#080808"
  },

  "usage_notes": {
    "scale_meaning": "50 = lightest shade, 500 = base reference, 900 = darkest shade.",
    "color_mode": "Grayscale only. All semantic colors intentionally use grayscale values.",
    "semantic_states": "Success, warning, danger, and info are differentiated primarily through brightness, contrast, icons, labels, and typography rather than hue.",
    "design_style": "Dark, minimalist, monochromatic, technical, restrained, and low visual noise.",
    "dark_mode": "Dark mode is the primary intended appearance. Use #080808 as the main background and #C0C0C0 as the default primary text.",
    "accessibility": "Verify text/background pairs meet WCAG 2.1 AA requirements for the target application.",
    "customization": "Do not introduce colored hues. If an application requires additional tokens, derive them from the existing grayscale palette instead of creating new colors."
  }
}
