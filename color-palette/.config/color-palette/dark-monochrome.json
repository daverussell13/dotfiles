  "usage_notes": {
    "scale_meaning": "50 = lightest shade, 500 = base reference, 900 = darkest shade.",
    "color_mode": "The core interface is grayscale-first. Semantic colors use restrained, desaturated hues only where color improves usability.",
    "semantic_states": "Success, warning, danger, and info use subtle hue combined with brightness and contrast. Color should not be the only indicator of state.",
    "design_style": "Dark, minimalist, monochromatic, technical, restrained, muted, and low visual noise.",
    "dark_mode": "Dark mode is the primary intended appearance. Use #080808 as the main background and #C0C0C0 as the default primary text.",
    "maximum_emphasis": "#FFFFFF is reserved for maximum visual emphasis, such as highly important headings, active states, selected content, critical values, and bright terminal output.",
    "accessibility": "Verify text/background pairs meet WCAG 2.1 AA requirements. Semantic colors should not be the only indicator of state.",
    "terminal_colors": "ANSI terminal colors use readable, desaturated hues rather than dark grayscale values. Standard semantic colors prioritize readability, while bright white uses #FFFFFF for maximum contrast.",
    "customization": "Keep the grayscale foundation intact. Additional colors should remain low-saturation, muted, and visually compatible with the existing palette."
  }
